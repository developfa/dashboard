# Environment Variables for Personal Task Dashboard
# Copy this file to .env and update the values
# Compatible with Synology NAS and Ubuntu Server environments

# ===============================================
# Database Configuration
# ===============================================
POSTGRES_PASSWORD=StrongDBPass2024!
POSTGRES_EXTERNAL_PORT=5432

# ===============================================
# Flask Application Configuration
# ===============================================
SECRET_KEY=your-very-secret-key-change-in-production-min-32-chars
FLASK_ENV=production
FLASK_EXTERNAL_PORT=8001

# Session Configuration
SESSION_TIMEOUT=24
SESSION_COOKIE_SECURE=true

# Application Settings
WTF_CSRF_ENABLED=true
TASKS_PER_PAGE=20
LOG_LEVEL=INFO

# Host Configuration (for direct Flask access)
HOST=0.0.0.0
PORT=5000

# ===============================================
# Docker Compose Configuration
# ===============================================
# Project name (affects container names)
COMPOSE_PROJECT_NAME=personal-task-dashboard

# Network Configuration
NETWORK_SUBNET=172.20.0.0/16

# ===============================================
# Port Configuration
# ===============================================
# HTTP/HTTPS ports (adjust if conflicts occur)
HTTP_PORT=80
HTTPS_PORT=443

# ===============================================
# Path Configuration (OS-specific)
# ===============================================
# Ubuntu Server paths (uncomment for Ubuntu)
# LOG_VOLUME_PATH=/var/log/personal-task-dashboard
# NGINX_LOG_PATH=/var/log/personal-task-dashboard/nginx

# Synology NAS paths (default)
LOG_VOLUME_PATH=./logs
NGINX_LOG_PATH=./nginx/logs

# ===============================================
# Domain Configuration
# ===============================================
DOMAIN=your-domain.com

# ===============================================
# Ubuntu-specific Configuration
# ===============================================
# Uncomment and configure these for Ubuntu deployment

# System paths
# PROJECT_ROOT=/opt/personal-task-dashboard
# BACKUP_ROOT=/var/backups/personal-task-dashboard
# LOG_ROOT=/var/log/personal-task-dashboard

# SSL Configuration (for Let's Encrypt)
# LETSENCRYPT_EMAIL=admin@your-domain.com
# LETSENCRYPT_STAGING=false

# ===============================================
# Optional: External Database Configuration
# ===============================================
# Uncomment if using external PostgreSQL instance
# POSTGRES_HOST=external-db-host
# POSTGRES_PORT=5432
# POSTGRES_DB=personal_dashboard
# POSTGRES_USER=pkm_user

# ===============================================
# Optional: Monitoring and Alerts
# ===============================================
# Uncomment for monitoring integrations
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK
# EMAIL_ALERTS_TO=admin@your-domain.com

# ===============================================
# Development Configuration
# ===============================================
# Uncomment for development environment
# FLASK_ENV=development
# FLASK_DEBUG=true
# LOG_LEVEL=DEBUG
# SESSION_COOKIE_SECURE=false